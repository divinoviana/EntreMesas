# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# IMPORTANTE: use a URL BASE, SEM /rest/v1/ no final.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-publishable-key

# NUNCA coloque a chave da Anthropic (ou qualquer segredo) com prefixo VITE_.
# Variáveis VITE_ são embutidas no bundle e ficam visíveis no navegador.
# Segredos (ANTHROPIC_API_KEY, service_role) só em funções server-side.
